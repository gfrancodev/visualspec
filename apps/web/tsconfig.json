{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@core": ["src/core/index.ts"],
      "@core/*": ["src/core/*"],
      "@feature/*": ["src/feature/*"],
      "@app/*": ["src/app/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
