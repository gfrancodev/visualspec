{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "node_modules/**",
    "public/schema/**",
    "public/examples/**",
    "public/registries/**",
    "public/specification/**",
    "public/targets/**",
    "public/llms.txt",
    "public/llms-full.txt",
    "artifacts/**",
    "**/*.astro",
  ],
}
