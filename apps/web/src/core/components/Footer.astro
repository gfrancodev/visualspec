---
import { SITE } from '../seo';
import { getLocale, t } from '@core/i18n';
import type { Locale } from '@core/i18n';

interface Props {
  locale?: Locale;
}

const { locale = getLocale() } = Astro.props;
const taglineLines = t('chrome.footerTagline', undefined, locale).split('\n');
---
<footer class="site-footer">
  <div class="footer-top">
    <a class="brand" href="/">visualspec.</a>
    <p>{taglineLines[0]}<br/>{taglineLines[1]}</p>
    <div class="footer-links">
      <a href="/specification/1.0/">{t('nav.specification', undefined, locale)}</a>
      <a href="/schemas/">{t('nav.schemas', undefined, locale)}</a>
      <a href="/use-cases/">{t('nav.useCases', undefined, locale)}</a>
      <a href={SITE.github} rel="me noopener noreferrer">{t('common.github', undefined, locale)}</a>
      <a href="/learn/contributing/">{t('nav.contributing', undefined, locale)}</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>{t('chrome.footerMaintained', undefined, locale)} <a href={SITE.authorUrl} rel="me noopener noreferrer">Gustavo Franco ↗</a></span>
    <span class="mono"><a href={SITE.license}>{t('chrome.footerLicense', undefined, locale)}</a> · {t('chrome.footerMotto', undefined, locale)}</span>
  </div>
</footer>
