---
import { t } from '@core/i18n';
import type { Locale } from '@core/i18n';

interface Props {
  locale: Locale;
}

const { locale: activeLocale } = Astro.props;

const options: Array<{ locale: Locale; labelKey: 'chrome.langEn' | 'chrome.langPtBr' | 'chrome.langEs'; short: string }> = [
  { locale: 'en', labelKey: 'chrome.langEn', short: 'EN' },
  { locale: 'pt-BR', labelKey: 'chrome.langPtBr', short: 'PT' },
  { locale: 'es', labelKey: 'chrome.langEs', short: 'ES' },
];

const activeOption = options.find((o) => o.locale === activeLocale) ?? options[0];
const activeShort = activeOption.short;
const triggerLabel = `${t('aria.language', undefined, activeLocale)}: ${t(activeOption.labelKey, undefined, activeLocale)}`;
const shortByLocale: Record<Locale, string> = {
  en: 'EN',
  'pt-BR': 'PT',
  es: 'ES',
};
const ariaLabelByLocale: Record<Locale, string> = {
  en: `${t('aria.language', undefined, 'en')}: ${t('chrome.langEn', undefined, 'en')}`,
  'pt-BR': `${t('aria.language', undefined, 'pt-BR')}: ${t('chrome.langPtBr', undefined, 'pt-BR')}`,
  es: `${t('aria.language', undefined, 'es')}: ${t('chrome.langEs', undefined, 'es')}`,
};
const listId = 'lang-switch-listbox';
const triggerId = 'lang-switch-trigger';
---
<div
  class="lang-switch"
  id="lang-switch"
  data-active-locale={activeLocale}
  data-short-map={JSON.stringify(shortByLocale)}
  data-aria-map={JSON.stringify(ariaLabelByLocale)}
>
  <button
    type="button"
    id={triggerId}
    class="lang-switch-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listId}
    aria-label={triggerLabel}
  >
    <span class="lang-switch-code" data-lang-code>{activeShort}</span>
    <svg class="lang-switch-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <ul id={listId} class="lang-switch-list" role="listbox" tabindex="-1" hidden>
    {options.map(({ locale, labelKey, short }) => (
      <li
        class="lang-switch-option"
        role="option"
        tabindex="-1"
        data-locale={locale}
        aria-selected={locale === activeLocale ? 'true' : 'false'}
        lang={locale === 'pt-BR' ? 'pt-BR' : locale}
      >
        <span class="lang-switch-option-code" aria-hidden="true">{short}</span>
        <span class="lang-switch-option-label" data-i18n={labelKey}>{t(labelKey, undefined, activeLocale)}</span>
      </li>
    ))}
  </ul>
</div>
<script>
  import { initLanguageSwitch } from '@core/i18n/language-switch.client';
  import type { Locale } from '@core/i18n';

  const root = document.getElementById('lang-switch');
  if (root) {
    initLanguageSwitch({
      activeLocale: (root.dataset.activeLocale ?? 'en') as Locale,
      shortByLocale: JSON.parse(root.dataset.shortMap ?? '{}'),
      ariaLabelByLocale: JSON.parse(root.dataset.ariaMap ?? '{}'),
    });
  }
</script>
