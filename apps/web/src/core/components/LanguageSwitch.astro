---
import { t } from '@core/i18n';
import type { Locale } from '@core/i18n';

interface Props {
  locale: Locale;
}

const { locale: activeLocale } = Astro.props;

const options: Array<{ locale: Locale; labelKey: 'chrome.langEn' | 'chrome.langPtBr' | 'chrome.langEs'; short: string }> = [
  { locale: 'en', labelKey: 'chrome.langEn', short: 'EN' },
  { locale: 'pt-BR', labelKey: 'chrome.langPtBr', short: 'PT' },
  { locale: 'es', labelKey: 'chrome.langEs', short: 'ES' },
];

const activeOption = options.find((o) => o.locale === activeLocale) ?? options[0];
const activeShort = activeOption.short;
const triggerLabel = `${t('aria.language', undefined, activeLocale)}: ${t(activeOption.labelKey, undefined, activeLocale)}`;
const shortByLocale: Record<Locale, string> = {
  en: 'EN',
  'pt-BR': 'PT',
  es: 'ES',
};
const listId = 'lang-switch-listbox';
const triggerId = 'lang-switch-trigger';
---
<div class="lang-switch" id="lang-switch">
  <button
    type="button"
    id={triggerId}
    class="lang-switch-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listId}
    aria-label={triggerLabel}
  >
    <span class="lang-switch-code" data-lang-code>{activeShort}</span>
    <svg class="lang-switch-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <ul id={listId} class="lang-switch-list" role="listbox" tabindex="-1" hidden>
    {options.map(({ locale, labelKey, short }) => (
      <li
        class="lang-switch-option"
        role="option"
        tabindex="-1"
        data-locale={locale}
        aria-selected={locale === activeLocale ? 'true' : 'false'}
        lang={locale === 'pt-BR' ? 'pt-BR' : locale}
      >
        <span class="lang-switch-option-code" aria-hidden="true">{short}</span>
        <span class="lang-switch-option-label">{t(labelKey, undefined, activeLocale)}</span>
      </li>
    ))}
  </ul>
</div>
<script is:inline define:vars={{ activeLocale, shortByLocale }}>
  (function () {
    var root = document.getElementById('lang-switch');
    var trigger = document.getElementById('lang-switch-trigger');
    var listbox = document.getElementById('lang-switch-listbox');
    var codeEl = root ? root.querySelector('[data-lang-code]') : null;
    var cookieName = 'vs_locale';
    var maxAge = 60 * 60 * 24 * 365;

    function readCookieLocale() {
      var parts = document.cookie.split(';');
      for (var i = 0; i < parts.length; i++) {
        var part = parts[i].trim();
        if (part.indexOf(cookieName + '=') === 0) {
          return decodeURIComponent(part.slice(cookieName.length + 1));
        }
      }
      return null;
    }

    function currentLocale() {
      return readCookieLocale() || document.documentElement.getAttribute('lang') || activeLocale;
    }

    function optionEls() {
      return listbox ? listbox.querySelectorAll('.lang-switch-option') : [];
    }

    function syncUi() {
      var current = currentLocale();
      if (codeEl) codeEl.textContent = shortByLocale[current] || shortByLocale.en || 'EN';
      optionEls().forEach(function (opt) {
        var selected = opt.getAttribute('data-locale') === current;
        opt.setAttribute('aria-selected', selected ? 'true' : 'false');
        opt.classList.toggle('is-selected', selected);
      });
    }

    function setLocale(locale) {
      if (locale === currentLocale()) {
        closeList();
        return;
      }
      document.cookie =
        cookieName + '=' + encodeURIComponent(locale) + '; Path=/; Max-Age=' + maxAge + '; SameSite=Lax';
      try {
        localStorage.setItem(cookieName, locale);
      } catch (e) {}
      location.reload();
    }

    function isOpen() {
      return trigger && trigger.getAttribute('aria-expanded') === 'true';
    }

    function openList() {
      if (!listbox || !trigger) return;
      listbox.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
      var selected = listbox.querySelector('.lang-switch-option[aria-selected="true"]');
      if (selected) selected.focus();
    }

    function closeList() {
      if (!listbox || !trigger) return;
      listbox.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
    }

    function toggleList() {
      if (isOpen()) closeList();
      else openList();
    }

    function focusOption(delta) {
      if (!listbox) return;
      var opts = Array.prototype.slice.call(optionEls());
      var idx = opts.findIndex(function (o) {
        return o === document.activeElement;
      });
      if (idx < 0) idx = opts.findIndex(function (o) {
        return o.getAttribute('aria-selected') === 'true';
      });
      var next = (idx + delta + opts.length) % opts.length;
      opts[next].focus();
    }

    syncUi();

    if (trigger) {
      trigger.addEventListener('click', function () {
        toggleList();
      });
      trigger.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (!isOpen()) openList();
          else focusOption(e.key === 'ArrowDown' ? 1 : -1);
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleList();
        }
      });
    }

    if (listbox) {
      listbox.addEventListener('click', function (e) {
        var opt = e.target.closest('.lang-switch-option');
        if (!opt) return;
        setLocale(opt.getAttribute('data-locale') || 'en');
      });
      listbox.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeList();
          trigger.focus();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          focusOption(1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          focusOption(-1);
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          var focused = document.activeElement;
          if (focused && focused.classList.contains('lang-switch-option')) {
            setLocale(focused.getAttribute('data-locale') || 'en');
          }
        } else if (e.key === 'Tab') {
          closeList();
        }
      });
    }

    document.addEventListener('click', function (e) {
      if (!root || !isOpen()) return;
      if (!root.contains(e.target)) closeList();
    });
  })();
</script>
