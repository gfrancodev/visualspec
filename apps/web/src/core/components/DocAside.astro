---
import { siteNavItems, t } from '@core/i18n';

interface ModuleLink { name: string; title: string }
interface Props {
  current?: string;
  modules?: ModuleLink[];
}
const { current = '', modules = [] } = Astro.props as Props;
const site = siteNavItems();
---
<aside class="sidebar" aria-label={t('aria.docAside')}>
  {modules.length > 0 && (
    <div class="sidebar-group">
      <h3>{t('docAside.modules')}</h3>
      <a href="/reference/" class:list={[{ active: current === 'reference' }]}>{t('common.overview')}</a>
      {modules.map((mod) => (
        <a href={`/reference/${mod.name}/`} class:list={[{ active: current === mod.name }]}>{mod.title}</a>
      ))}
    </div>
  )}
  <div class="sidebar-group">
    <h3>{t('docAside.site')}</h3>
    {site.map(({ href, label, id }) => (
      <a href={href} class:list={[{ active: current === id || current.startsWith(`${id}/`) }]}>{label}</a>
    ))}
  </div>
</aside>
