---
import { getMessages } from '@core/i18n';

interface Props {
  caption?: string;
  badge?: string;
  variant?: 'default' | 'doc';
}
const defaults = getMessages().chrome;
const {
  caption = defaults.specWindowDefaultCaption,
  badge = defaults.specWindowBadgeJson,
  variant = 'default',
} = Astro.props;
---
<div class:list={['spec-window', variant === 'doc' && 'spec-window--doc']}>
  <div class="window-bar"><i></i><i></i><i></i><span>{caption}</span><b>{badge}</b></div>
  <slot />
</div>
