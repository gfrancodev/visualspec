---
import Logo from './Logo.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { mainNavItems, mobileExtraNavItems, t } from '@core/i18n';
import type { Locale } from '@core/i18n';

interface Props {
  path: string;
  locale: Locale;
}
const { path, locale } = Astro.props;
const nav = mainNavItems(locale);
const mobileExtra = mobileExtraNavItems(locale);
---
<header class="site-header">
  <div class="nav-wrap">
    <Logo />
    <span class="version-tag">{t('chrome.versionTag', undefined, locale)}</span>
    <nav class="desktop-nav" aria-label={t('aria.mainNav', undefined, locale)}>
      {nav.map(({ label, href }) => (
        <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <LanguageSwitch locale={locale} />
    <ThemeSwitch locale={locale} />
    <a class="github-link" href="https://github.com/gfrancodev/visualspec" target="_blank" rel="me noopener noreferrer">{t('common.github', undefined, locale)} <span aria-hidden="true">↗</span></a>
    <details class="mobile-nav">
      <summary aria-label={t('aria.openNav', undefined, locale)}><span></span><span></span></summary>
      <nav aria-label={t('aria.mobileNav', undefined, locale)}>
        {nav.map(({ label, href }) => <a href={href}>{label}</a>)}
        {mobileExtra.map(({ label, href }) => <a href={href}>{label}</a>)}
      </nav>
    </details>
  </div>
</header>
