---
import Logo from './Logo.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { MAIN_NAV, MOBILE_EXTRA_NAV, t } from '@core/i18n';
import type { Locale } from '@core/i18n';

interface Props {
  path: string;
  locale: Locale;
}
const { path, locale } = Astro.props;
---
<header class="site-header">
  <div class="nav-wrap">
    <Logo />
    <span class="version-tag" data-i18n="chrome.versionTag">{t('chrome.versionTag', undefined, locale)}</span>
    <nav class="desktop-nav" data-i18n-aria-label="aria.mainNav" aria-label={t('aria.mainNav', undefined, locale)}>
      {MAIN_NAV.map(({ labelKey, href }) => (
        <a href={href} data-i18n={labelKey} aria-current={path.startsWith(href) ? 'page' : undefined}>{t(labelKey, undefined, locale)}</a>
      ))}
    </nav>
    <LanguageSwitch locale={locale} />
    <ThemeSwitch locale={locale} />
    <a class="github-link" href="https://github.com/gfrancodev/visualspec" target="_blank" rel="me noopener noreferrer"><span data-i18n="common.github">{t('common.github', undefined, locale)}</span> <span aria-hidden="true">↗</span></a>
    <details class="mobile-nav">
      <summary data-i18n-aria-label="aria.openNav" aria-label={t('aria.openNav', undefined, locale)}><span></span><span></span></summary>
      <nav data-i18n-aria-label="aria.mobileNav" aria-label={t('aria.mobileNav', undefined, locale)}>
        {MAIN_NAV.map(({ labelKey, href }) => (
          <a href={href} data-i18n={labelKey}>{t(labelKey, undefined, locale)}</a>
        ))}
        {MOBILE_EXTRA_NAV.map(({ labelKey, href }) => (
          <a href={href} data-i18n={labelKey}>{t(labelKey, undefined, locale)}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
