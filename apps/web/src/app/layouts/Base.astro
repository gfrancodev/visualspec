---
import { Header, Footer } from '@core';
import { DEFAULT_LOCALE, htmlLangAttr, t } from '@core/i18n';
import type { Locale } from '@core/i18n';
import { SITE, canonicalUrl, documentTitle, siteJsonLd } from '@core/seo';
import '@core/styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  noindex?: boolean;
  pageType?: 'website' | 'article';
}
const {
  title,
  description = SITE.description,
  wide = false,
  noindex = false,
  pageType = 'website'
} = Astro.props;
const path = Astro.url.pathname;
const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const htmlLang = htmlLangAttr(locale);
const canonical = canonicalUrl(path);
const fullTitle = documentTitle(title);
const jsonLd = siteJsonLd({
  title: fullTitle,
  description,
  url: canonical,
  pageType
});
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{fullTitle}</title>
  <meta name="description" content={description}/>
  <meta name="author" content={SITE.author}/>
  <meta name="creator" content={SITE.author}/>
  {noindex
    ? <meta name="robots" content="noindex, follow"/>
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"/>}
  <meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <link rel="manifest" href="/site.webmanifest"/>
  <link rel="sitemap" type="application/xml" href="/sitemap.xml"/>
  <link rel="alternate" type="text/plain" href="/llms.txt" title={t('meta.llmIndexTitle', undefined, locale)}/>
  <link rel="license" href={SITE.license}/>
  <meta name="theme-color" content="#f7f8f3" media="(prefers-color-scheme: light)"/>
  <meta name="theme-color" content="#20231e" media="(prefers-color-scheme: dark)"/>
  <meta name="color-scheme" content="light dark"/>
  <meta name="application-name" content={SITE.name}/>
  <meta property="og:site_name" content={SITE.name}/>
  <meta property="og:locale" content={SITE.locale}/>
  <meta property="og:title" content={fullTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={SITE.ogImage}/>
  <meta property="og:image:alt" content={SITE.ogImageAlt}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={fullTitle}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={SITE.ogImage}/>
  <meta name="twitter:image:alt" content={SITE.ogImageAlt}/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <script is:inline>
    (function () {
      function resolve(stored) {
        if (stored === 'dark' || stored === 'light') return stored;
        return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      var stored = localStorage.getItem('visualspec-theme');
      var mode = stored === 'dark' || stored === 'light' || stored === 'system' ? stored : 'system';
      var theme = resolve(mode === 'system' ? null : mode);
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.themeMode = mode;
      document.documentElement.style.colorScheme = theme;
    })();
  </script>
</head>
<body class:list={[{ wide }]}>
  <a class="skip-link" href="#main">{t('aria.skipToContent', undefined, locale)}</a>
  <Header path={path} locale={locale} />
  <main id="main"><slot/></main>
  <Footer locale={locale} />
  <Analytics />
  <SpeedInsights />
</body>
</html>
