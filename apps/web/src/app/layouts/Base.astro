---
import { Header, Footer } from '@core';
import '@core/styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  description = 'A machine-readable contract for visual intent. An open specification for how things look, move, behave and render.',
  wide = false
} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#f7f8f3"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="canonical" href={new URL(path, 'https://visualspec.dev')}/>
  <meta property="og:title" content={`${title} - Visual Spec`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={new URL(path, 'https://visualspec.dev')}/>
  <title>{title === 'Visual Spec' ? 'Visual Spec - A contract for visual intent' : `${title} - Visual Spec`}</title>
  <script is:inline>
    (function () {
      function resolve(stored) {
        if (stored === 'dark' || stored === 'light') return stored;
        return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      var stored = localStorage.getItem('visualspec-theme');
      var mode = stored === 'dark' || stored === 'light' || stored === 'system' ? stored : 'system';
      var theme = resolve(mode === 'system' ? null : mode);
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.themeMode = mode;
      document.documentElement.style.colorScheme = theme;
    })();
  </script>
</head>
<body class:list={[{ wide }]}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header path={path} />
  <main id="main"><slot/></main>
  <Footer />
</body>
</html>
