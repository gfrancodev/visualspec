---
import Base from '@app/layouts/Base.astro';
import { t } from '@core/i18n';
import { hrefFor, loadDocs } from './lib/docs';

const docs = loadDocs();
const categories = [...new Set(docs.map((d) => d.category))];
const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={p('pages.learn.title')} description={p('pages.learn.description')}>
  <div class="container">
    <header class="page-head">
      <div class="eyebrow" data-i18n="pages.learn.eyebrow">{p('pages.learn.eyebrow')}</div>
      <h1 data-i18n="pages.learn.heading">{p('pages.learn.heading')}</h1>
      <p data-i18n="pages.learn.lead">{p('pages.learn.lead')}</p>
    </header>
    {categories.map((category) => (
      <section class="index-list" aria-labelledby={`cat-${category}`}>
        <h2 id={`cat-${category}`} class="mono" style="font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin:0 0 8px">{category}</h2>
        {docs.filter((d) => d.category === category).map((doc) => (
          <a class="index-row" href={hrefFor(doc.slug)}>
            <div>
              <div class="row-title">{doc.title}</div>
              <p>{doc.description}</p>
            </div>
            <span class="mono">{doc.slug}</span>
          </a>
        ))}
      </section>
    ))}
  </div>
</Base>
