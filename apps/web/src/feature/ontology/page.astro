---
import Base from '@app/layouts/Base.astro';
import { DocAside } from '@core';
import { t } from '@core/i18n';
import { loadComponents } from './catalog';

const components = loadComponents();
const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={p('pages.components.title')} description={p('pages.components.description')}>
  <div class="container doc-layout">
    <DocAside current="components" />
    <div>
    <header class="page-head">
      <div class="eyebrow">{p('pages.components.eyebrow')}</div>
      <h1>{p('pages.components.heading')}</h1>
      <p>{p('pages.components.lead')}</p>
    </header>
    {components.length === 0 ? (
      <div class="callout">
        <strong>{p('pages.components.registryPending')}</strong> {p('pages.components.registryPendingBody')}
      </div>
    ) : (
      <div class="index-list">
        {components.map((c) => (
          <a class="index-row" href={`/components/${c.kind}/`}>
            <div>
              <div class="row-title">{c.title}</div>
              <p>{c.summary}</p>
            </div>
            <span class="mono">{c.kind}</span>
          </a>
        ))}
      </div>
    )}
    </div>
  </div>
</Base>
