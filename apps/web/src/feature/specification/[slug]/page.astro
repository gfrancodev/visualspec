---
import Base from '@app/layouts/Base.astro';
import { renderSpecFile, sidebarPages } from '../lib/spec';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const html = renderSpecFile(`${slug}.md`);
const title = slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const pages = sidebarPages();
---
<Base title={`${title} | Specification 1.0`} description={`Visual Spec 1.0 ${title.toLowerCase()} chapter: normative rules for the open visual intermediate representation (Visual IR).`} pageType="article">
  <div class="container doc-layout">
    <aside class="sidebar" aria-label="Specification navigation">
      <div class="sidebar-group">
        <h3>Specification 1.0</h3>
        <a href="/specification/1.0/">Overview</a>
        {pages.map((p) => (
          <a href={p.href} class:list={[{ active: p.name === slug }]}>{p.label}</a>
        ))}
      </div>
    </aside>
    <div>
      <header class="page-head" style="padding-top:0">
        <div class="eyebrow">Specification 1.0</div>
      </header>
      {html ? (
        <article class="prose" set:html={html}></article>
      ) : (
        <div class="callout">
          <strong>Page unavailable.</strong> Expected source at <code>specification/1.0/{slug}.md</code>.
        </div>
      )}
    </div>
  </div>
</Base>
