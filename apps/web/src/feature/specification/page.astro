---
import Base from '@app/layouts/Base.astro';
import { t } from '@core/i18n';
import { renderSpecFile, sidebarPages } from './lib/spec';

const html = renderSpecFile('index.md');
const pages = sidebarPages();
const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={p('pages.specification.title')} description={p('pages.specification.description')} pageType="article">
  <div class="container doc-layout">
    <aside class="sidebar" aria-label={t('aria.specNav')}>
      <div class="sidebar-group">
        <h3>{p('pages.specification.sidebarTitle')}</h3>
        <a href="/specification/1.0/" class="active">{t('common.overview')}</a>
        {pages.map((page) => <a href={page.href}>{page.label}</a>)}
      </div>
    </aside>
    <div>
      <header class="page-head" style="padding-top:0">
        <div class="eyebrow">{p('pages.specification.eyebrow')}</div>
      </header>
      {html ? (
        <article class="prose" set:html={html}></article>
      ) : (
        <div class="callout">
          <strong>{p('pages.specification.unavailableTitle')}</strong> {p('pages.specification.unavailableBody')}
        </div>
      )}
    </div>
  </div>
</Base>
