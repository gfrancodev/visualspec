---
import Base from '@app/layouts/Base.astro';
import { SpecWindow } from '@core';
import { DEFAULT_LOCALE, getMessages } from '@core/i18n';
import type { Locale } from '@core/i18n';

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const home = getMessages(locale).home;
const heroCode = `<span class="code-line">{</span><span class="code-line">  <span class="key">"visualSpec"</span>: <span class="value">"1.0"</span>,</span><span class="code-line">  <span class="key">"profiles"</span>: [<span class="value">"ui"</span>],</span><span class="code-line">  <span class="key">"components"</span>: [{</span><span class="code-line">    <span class="key">"id"</span>: <span class="value">"button.primary"</span>,</span><span class="code-line highlight">    <span class="key">"kind"</span>: <span class="value">"action.button"</span>,</span><span class="code-line">    <span class="key">"appearance"</span>: {</span><span class="code-line">      <span class="key">"fill"</span>: <span class="value">"{color.brand}"</span>,</span><span class="code-line">      <span class="key">"radius"</span>: <span class="value">"8px"</span></span><span class="code-line">    }</span><span class="code-line">  }]</span><span class="code-line">}</span>`;
---
<Base title="Visual Spec">
<section class="hero container"><div class="hero-grid"><div><div class="eyebrow">{home.heroEyebrow}</div><h1>{home.heroTitle}<br/><span class="serif">{home.heroTitleAccent}</span></h1><p class="hero-copy">{home.heroCopy}</p><div class="hero-actions"><a class="button" href="/learn/quick-start/">{home.getStarted} <span>↗</span></a><a class="button secondary" href="/specification/1.0/">{home.readSpecification} <span>→</span></a></div><p class="hero-note">{home.heroNote}</p></div><div class="hero-art"><div class="artifact-heading"><span>{home.artifactIntent}</span><span>{home.artifactFile}</span></div><SpecWindow caption={home.specCaption} badge="JSON"><pre class="spec-code" set:html={heroCode}></pre><div class="preview-strip"><div class="mini-orb">↗</div><div><strong>{home.previewTitle}</strong><p>{home.previewCopy}</p></div><span class="live-label">{home.previewBadge}</span></div></SpecWindow></div></div><div class="source-strip"><span>{home.sourceStrip}</span><div class="source-names">{home.sourceTools.map((name) => <span>{name}</span>)}</div></div></section>
<section class="section"><div class="container"><div class="eyebrow">{home.section1Eyebrow}</div><div class="section-heading"><h2>{home.section1Title}<br/>{home.section1TitleLine2}</h2><p>{home.section1Copy}</p></div><div class="workflow"><div class="flow-side"><div class="flow-label">{home.flowSources}</div>{home.sources.map(([icon, label]) => <div class="flow-item"><span>{icon}</span>{label}</div>)}</div><a href="/learn/concepts/" class="flow-core"><span>{home.flowCoreLabel}</span><strong>visualspec.</strong><span>{home.flowCoreTagline}</span></a><div class="flow-side"><div class="flow-label">{home.flowTargets}</div>{home.targets.map(([icon, label]) => <div class="flow-item"><span>{icon}</span>{label}</div>)}</div></div><div class="flow-validation">{home.flowValidation}</div></div></section>
<section class="section dark-section"><div class="container"><div class="eyebrow">{home.section2Eyebrow}</div><div class="section-heading"><h2>{home.section2Title}<br/><span class="serif">{home.section2TitleAccent}</span></h2><a class="text-link" href="/why/">{home.whyLink} <span>↗</span></a></div><div class="principles">{home.principles.map((principle) => <div class="principle"><span class="number">{principle.number}</span><h3>{principle.title}</h3><p>{principle.body}</p></div>)}</div></div></section>
<section class="section"><div class="container"><div class="eyebrow">{home.section3Eyebrow}</div><div class="section-heading"><h2>{home.section3Title}</h2><p>{home.section3Copy}</p></div><div class="profile-grid">{home.profiles.map((profile, i) => <a class="profile-card" href={`/profiles/${profile.id}/`}><div class="profile-card-top"><span class="mono">0{i + 1} / {profile.id.toUpperCase()}</span><span>↗</span></div><h3>{profile.title}</h3><p>{profile.description}</p></a>)}</div></div></section>
<section class="cta-section container"><div class="cta-row"><div><div class="eyebrow">{home.ctaEyebrow}</div><h2>{home.ctaTitle} <span class="serif">{home.ctaTitleAccent}</span></h2><p>{home.ctaCopy}</p></div><div class="hero-actions"><a class="button" href="/use-cases/">{home.browseUseCases} <span>↗</span></a><a class="button secondary" href="/schemas/">{home.getSchemas} <span>↓</span></a></div></div></section>
</Base>
