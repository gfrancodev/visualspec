---
import Base from '@app/layouts/Base.astro';
import { SpecWindow } from '@core';
import { DEFAULT_LOCALE, getMessages } from '@core/i18n';
import type { Locale } from '@core/i18n';

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const home = getMessages(locale).home;
const heroCode = `<span class="code-line">{</span><span class="code-line">  <span class="key">"visualSpec"</span>: <span class="value">"1.0"</span>,</span><span class="code-line">  <span class="key">"profiles"</span>: [<span class="value">"ui"</span>],</span><span class="code-line">  <span class="key">"components"</span>: [{</span><span class="code-line">    <span class="key">"id"</span>: <span class="value">"button.primary"</span>,</span><span class="code-line highlight">    <span class="key">"kind"</span>: <span class="value">"action.button"</span>,</span><span class="code-line">    <span class="key">"appearance"</span>: {</span><span class="code-line">      <span class="key">"fill"</span>: <span class="value">"{color.brand}"</span>,</span><span class="code-line">      <span class="key">"radius"</span>: <span class="value">"8px"</span></span><span class="code-line">    }</span><span class="code-line">  }]</span><span class="code-line">}</span>`;
---
<Base title="Visual Spec">
<section class="hero container"><div class="hero-grid"><div><div class="eyebrow" data-i18n="home.heroEyebrow">{home.heroEyebrow}</div><h1><span data-i18n="home.heroTitle">{home.heroTitle}</span><br/><span class="serif" data-i18n="home.heroTitleAccent">{home.heroTitleAccent}</span></h1><p class="hero-copy" data-i18n="home.heroCopy">{home.heroCopy}</p><div class="hero-actions"><a class="button" href="/learn/quick-start/"><span data-i18n="home.getStarted">{home.getStarted}</span> <span>↗</span></a><a class="button secondary" href="/specification/1.0/"><span data-i18n="home.readSpecification">{home.readSpecification}</span> <span>→</span></a></div><p class="hero-note" data-i18n="home.heroNote">{home.heroNote}</p></div><div class="hero-art"><div class="artifact-heading"><span data-i18n="home.artifactIntent">{home.artifactIntent}</span><span data-i18n="home.artifactFile">{home.artifactFile}</span></div><SpecWindow caption={home.specCaption} captionKey="home.specCaption" badge="JSON"><pre class="spec-code" set:html={heroCode}></pre><div class="preview-strip"><div class="mini-orb">↗</div><div><strong data-i18n="home.previewTitle">{home.previewTitle}</strong><p data-i18n="home.previewCopy">{home.previewCopy}</p></div><span class="live-label" data-i18n="home.previewBadge">{home.previewBadge}</span></div></SpecWindow></div></div><div class="source-strip"><span data-i18n="home.sourceStrip">{home.sourceStrip}</span><div class="source-names">{home.sourceTools.map((name, i) => <span data-i18n={`home.sourceTools.${i}`}>{name}</span>)}</div></div></section>
<section class="section"><div class="container"><div class="eyebrow" data-i18n="home.section1Eyebrow">{home.section1Eyebrow}</div><div class="section-heading"><h2><span data-i18n="home.section1Title">{home.section1Title}</span><br/><span data-i18n="home.section1TitleLine2">{home.section1TitleLine2}</span></h2><p data-i18n="home.section1Copy">{home.section1Copy}</p></div><div class="workflow"><div class="flow-side"><div class="flow-label" data-i18n="home.flowSources">{home.flowSources}</div>{home.sources.map(([icon, label], i) => <div class="flow-item"><span>{icon}</span><span data-i18n={`home.sources.${i}.1`}>{label}</span></div>)}</div><a href="/learn/concepts/" class="flow-core"><span data-i18n="home.flowCoreLabel">{home.flowCoreLabel}</span><strong>visualspec.</strong><span data-i18n="home.flowCoreTagline">{home.flowCoreTagline}</span></a><div class="flow-side"><div class="flow-label" data-i18n="home.flowTargets">{home.flowTargets}</div>{home.targets.map(([icon, label], i) => <div class="flow-item"><span>{icon}</span><span data-i18n={`home.targets.${i}.1`}>{label}</span></div>)}</div></div><div class="flow-validation" data-i18n="home.flowValidation">{home.flowValidation}</div></div></section>
<section class="section dark-section"><div class="container"><div class="eyebrow" data-i18n="home.section2Eyebrow">{home.section2Eyebrow}</div><div class="section-heading"><h2><span data-i18n="home.section2Title">{home.section2Title}</span><br/><span class="serif" data-i18n="home.section2TitleAccent">{home.section2TitleAccent}</span></h2><a class="text-link" href="/why/"><span data-i18n="home.whyLink">{home.whyLink}</span> <span>↗</span></a></div><div class="principles">{home.principles.map((principle, i) => <div class="principle"><span class="number" data-i18n={`home.principles.${i}.number`}>{principle.number}</span><h3 data-i18n={`home.principles.${i}.title`}>{principle.title}</h3><p data-i18n={`home.principles.${i}.body`}>{principle.body}</p></div>)}</div></div></section>
<section class="section"><div class="container"><div class="eyebrow" data-i18n="home.section3Eyebrow">{home.section3Eyebrow}</div><div class="section-heading"><h2 data-i18n="home.section3Title">{home.section3Title}</h2><p data-i18n="home.section3Copy">{home.section3Copy}</p></div><div class="profile-grid">{home.profiles.map((profile, i) => <a class="profile-card" href={`/profiles/${profile.id}/`}><div class="profile-card-top"><span class="mono">0{i + 1} / {profile.id.toUpperCase()}</span><span>↗</span></div><h3 data-i18n={`home.profiles.${i}.title`}>{profile.title}</h3><p data-i18n={`home.profiles.${i}.description`}>{profile.description}</p></a>)}</div></div></section>
<section class="cta-section container"><div class="cta-row"><div><div class="eyebrow" data-i18n="home.ctaEyebrow">{home.ctaEyebrow}</div><h2><span data-i18n="home.ctaTitle">{home.ctaTitle}</span> <span class="serif" data-i18n="home.ctaTitleAccent">{home.ctaTitleAccent}</span></h2><p data-i18n="home.ctaCopy">{home.ctaCopy}</p></div><div class="hero-actions"><a class="button" href="/use-cases/"><span data-i18n="home.browseUseCases">{home.browseUseCases}</span> <span>↗</span></a><a class="button secondary" href="/schemas/"><span data-i18n="home.getSchemas">{home.getSchemas}</span> <span>↓</span></a></div></div></section>
</Base>
