---
import Base from '@app/layouts/Base.astro';
import { DocAside } from '@core';
import { t } from '@core/i18n';
import { loadRfcs } from './catalog';

const rfcs = loadRfcs();
const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={p('pages.rfcs.title')} description={p('pages.rfcs.description')}>
  <div class="container doc-layout">
    <DocAside current="rfcs" />
    <div>
    <header class="page-head">
      <div class="eyebrow">{p('pages.rfcs.eyebrow')}</div>
      <h1>{p('pages.rfcs.heading')}</h1>
      <p>{p('pages.rfcs.lead')}</p>
    </header>

    {rfcs.length === 0 ? (
      <div class="callout">
        <strong>{p('pages.rfcs.emptyTitle')}</strong> {p('pages.rfcs.emptyBody')}
      </div>
    ) : (
      <div class="index-list">
        {rfcs.map((rfc) => (
          <a class="index-row" href={`/rfcs/${rfc.slug}/`}>
            <div>
              <div class="row-title">{rfc.title}</div>
              <p>{p('pages.rfcs.statusLabel')} {rfc.status}</p>
            </div>
            <span class="mono">{rfc.id}</span>
          </a>
        ))}
      </div>
    )}
    </div>
  </div>
</Base>
