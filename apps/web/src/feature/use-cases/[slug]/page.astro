---
import Base from '@app/layouts/Base.astro';
import { SpecWindow, jsonToSpecCodeHtml } from '@core';
import { t } from '@core/i18n';
import { getUseCase, readUseCaseDocument } from '../catalog';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const item = getUseCase(slug);
if (!item) {
  return Astro.redirect(`/404/?path=${encodeURIComponent(Astro.url.pathname)}`);
}
const doc = readUseCaseDocument(item.file);
const pretty = JSON.stringify(doc, null, 2);
const specCodeHtml = jsonToSpecCodeHtml(pretty);
const openLabel =
  item.artifact?.kind === 'pptx'
    ? t('pages.useCases.openDeck')
    : item.artifact?.kind === 'pdf'
      ? t('pages.useCases.openPdf')
      : item.artifact?.kind === 'video'
        ? t('pages.useCases.openVideo')
        : t('pages.useCases.openArtifact');
const p = (key: Parameters<typeof t>[0], params?: Parameters<typeof t>[1]) => t(key, params);
---
<Base
  title={p('pages.useCases.detailTitleSuffix', { title: item.title })}
  description={p('pages.useCases.detailDescription', { profiles: item.profiles.join(', '), title: item.title })}
  pageType="article"
>
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">{p('pages.useCases.eyebrowDetail')}</div>
      <h1>{item.title}</h1>
      <p>
        {p('pages.useCases.profilesLabel')} {item.profiles.join(', ')}
        {item.modelLabel && (
          <>
            {' '}
            · {p('pages.useCases.generatedWith')} <span class="mono">{item.modelLabel}</span>
          </>
        )}
      </p>
      <div class="hero-actions" style="margin-top:18px">
        <a class="button secondary small" href={`/examples/${item.file}`}>{p('pages.useCases.downloadJson')} <span>↓</span></a>
        {item.ready && (
          <a class="button secondary small" href={item.download} download={item.artifact?.kind === 'pptx' ? '' : undefined}>
            {openLabel} <span>↗</span>
          </a>
        )}
      </div>
    </header>
    {item.ready ? (
      <div class="target-stage-shell">
        {item.artifact?.kind === 'pdf' ? (
          <iframe
            class="target-stage"
            title={p('pages.useCases.artifactPreview', { title: item.title })}
            src={item.preview}
          ></iframe>
        ) : (
          <iframe
            class="target-stage"
            title={p('pages.useCases.artifactPreview', { title: item.title })}
            src={item.preview}
            sandbox="allow-scripts allow-same-origin"
          ></iframe>
        )}
      </div>
    ) : (
      <p class="callout">{p('pages.useCases.artifactPending')}</p>
    )}
    <header class="page-head" style="margin-top:48px">
      <div class="eyebrow">{p('pages.useCases.inputEyebrow')}</div>
      <h2>{p('pages.useCases.inputHeading')}</h2>
      <p class="mono">{item.file}</p>
    </header>
    <div class="code-block">
      <button class="copy-button" type="button" data-copy-text={pretty}>{t('common.copy')}</button>
      <SpecWindow caption={item.file} badge="JSON" variant="doc">
        <pre class="spec-code" set:html={specCodeHtml}></pre>
      </SpecWindow>
    </div>
  </div>
  <script>
    import { bindCopyButtons } from '@core/components/CopyButton';
    bindCopyButtons();
  </script>
</Base>
