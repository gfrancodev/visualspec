---
import Base from '@app/layouts/Base.astro';
import { DocAside } from '@core';
import { t } from '@core/i18n';

const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={p('pages.ecosystem.title')} description={p('pages.ecosystem.description')}>
  <div class="container doc-layout">
    <DocAside current="ecosystem" />
    <div>
    <header class="page-head">
      <div class="eyebrow">{p('pages.ecosystem.eyebrow')}</div>
      <h1>{p('pages.ecosystem.heading')}</h1>
      <p>{p('pages.ecosystem.lead')}</p>
    </header>

    <div class="grid-2">
      <article class="resource-card">
        <div class="mono"><span class="status-dot"></span>{p('pages.ecosystem.shipped')}</div>
        <h3>{p('pages.ecosystem.specTitle')}</h3>
        <p>{p('pages.ecosystem.specBody')}</p>
        <a class="text-link" href="/specification/1.0/">{p('pages.ecosystem.readSpec')} <span>↗</span></a>
      </article>

      <article class="resource-card">
        <div class="mono"><span class="status-dot"></span>{p('pages.ecosystem.shipped')}</div>
        <h3>{p('pages.ecosystem.validatorTitle')}</h3>
        <p>{p('pages.ecosystem.validatorBody')}</p>
        <a class="text-link" href="/learn/conformance/">{p('pages.ecosystem.conformanceLink')} <span>↗</span></a>
      </article>

      <article class="resource-card">
        <div class="mono"><span class="status-dot"></span>{p('pages.ecosystem.shipped')}</div>
        <h3>{p('pages.ecosystem.pagesTitle')}</h3>
        <p>{p('pages.ecosystem.pagesBody')}</p>
        <a class="text-link" href="/use-cases/">{p('home.browseUseCases')} <span>↗</span></a>
      </article>

      <article class="resource-card">
        <div class="mono"><span class="status-dot"></span>{p('pages.ecosystem.shipped')}</div>
        <h3>{p('pages.ecosystem.explorerTitle')}</h3>
        <p>{p('pages.ecosystem.explorerBody')}</p>
        <a class="text-link" href="/reference-explorer/">{p('pages.ecosystem.openExplorer')} <span>↗</span></a>
      </article>
    </div>

    <section class="schema-section">
      <h2>{p('pages.ecosystem.adaptersHeading')}</h2>
      <div class="callout">
        <strong>{p('pages.ecosystem.adaptersCallout')}</strong> {p('pages.ecosystem.adaptersCalloutBody')}
      </div>
      <p>{p('pages.ecosystem.adaptersP1')}</p>
      <p>
        {p('pages.ecosystem.adaptersP2Prefix')} <a href="/learn/adapter-guide/">{p('pages.ecosystem.adapterGuide')}</a> {p('pages.ecosystem.adaptersP2Mid')} <a href="/rfcs/">{p('pages.ecosystem.rfcProcess')}</a>{p('pages.ecosystem.adaptersP2Suffix')}
      </p>
    </section>
    </div>
  </div>
</Base>
