---
import Base from '@app/layouts/Base.astro';
import { t } from '@core/i18n';
import { loadProfiles } from './catalog';

const profiles = loadProfiles();
const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={p('pages.profiles.title')} description={p('pages.profiles.description')}>
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">{p('pages.profiles.eyebrow')}</div>
      <h1>{p('pages.profiles.heading')}</h1>
      <p>{p('pages.profiles.lead')}</p>
    </header>
    <div class="index-list">
      {profiles.map((profile) => (
        <a class="index-row" href={`/profiles/${profile.id}/`}>
          <div>
            <div class="row-title">{profile.title}</div>
            <p>{profile.description}</p>
          </div>
          <span class="mono">{profile.id}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
