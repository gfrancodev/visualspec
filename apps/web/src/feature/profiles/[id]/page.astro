---
import Base from '@app/layouts/Base.astro';
import { loadProfiles } from '../catalog';

interface Props {
  id: string;
}

const { id } = Astro.props;
const profile = loadProfiles().find((item) => item.id === id);
if (!profile) {
  return Astro.redirect(`/404/?path=${encodeURIComponent(Astro.url.pathname)}`);
}
const exampleName = profile.example.replace(/\.json$/, '');
---
<Base title={`${profile.title} | Profile`} description={`${profile.description} Visual Spec profile for the open visual intermediate representation.`} pageType="article">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">Profile · {profile.id}</div>
      <h1>{profile.title}</h1>
      <p>{profile.description}</p>
    </header>

    <section class="schema-section">
      <h2>Typical uses</h2>
      <ul>
        {profile.uses.map((use) => <li>{use}</li>)}
      </ul>
    </section>

    <section class="schema-section">
      <h2>Related modules</h2>
      <div class="filter-bar">
        {profile.modules.map((m) => (
          <a class="chip" href={`/reference/${m}/`}>{m}</a>
        ))}
      </div>
    </section>

    <section class="schema-section">
      <h2>Artifacts</h2>
      <div class="hero-actions">
        <a class="button small" href={`/use-cases/${exampleName}/`}>View use case</a>
        <a class="button secondary small" href={`/schema/1.0/profiles/${profile.id}.schema.json`}>Profile schema</a>
      </div>
    </section>
  </div>
</Base>
