---
import Base from '@app/layouts/Base.astro';
import { t } from '@core/i18n';
import { loadProfiles } from '../catalog';

interface Props {
  id: string;
}

const { id } = Astro.props;
const profile = loadProfiles().find((item) => item.id === id);
if (!profile) {
  return Astro.redirect(`/404/?path=${encodeURIComponent(Astro.url.pathname)}`);
}
const exampleName = profile.example.replace(/\.json$/, '');
const p = (key: Parameters<typeof t>[0], params?: Parameters<typeof t>[1]) => t(key, params);
---
<Base
  title={p('pages.profiles.detailTitleSuffix', { title: profile.title })}
  description={p('pages.profiles.detailDescription', { description: profile.description })}
  pageType="article"
>
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">{p('pages.profiles.eyebrowDetail', { id: profile.id })}</div>
      <h1>{profile.title}</h1>
      <p>{profile.description}</p>
    </header>

    <section class="schema-section">
      <h2>{p('pages.profiles.typicalUses')}</h2>
      <ul>
        {profile.uses.map((use) => <li>{use}</li>)}
      </ul>
    </section>

    <section class="schema-section">
      <h2>{p('pages.profiles.relatedModules')}</h2>
      <div class="filter-bar">
        {profile.modules.map((m) => (
          <a class="chip" href={`/reference/${m}/`}>{m}</a>
        ))}
      </div>
    </section>

    <section class="schema-section">
      <h2>{p('pages.profiles.artifacts')}</h2>
      <div class="hero-actions">
        <a class="button small" href={`/use-cases/${exampleName}/`}>{p('pages.profiles.viewUseCase')}</a>
        <a class="button secondary small" href={`/schema/1.0/profiles/${profile.id}.schema.json`}>{p('pages.profiles.profileSchema')}</a>
      </div>
    </section>
  </div>
</Base>
