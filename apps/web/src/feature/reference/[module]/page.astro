---
import { join } from 'node:path';
import Base from '@app/layouts/Base.astro';
import { DocAside, catalogPath, jsonToSpecCodeHtml, modulesDir, readJson, SpecWindow } from '@core';
import { t } from '@core/i18n';
import SchemaNode from '../SchemaNode.astro';
import { MODULE_GUIDES } from '../guides';
import { describeNode, minimalExample } from '../schema';

interface CatalogModule { name: string; title: string; description: string; definitions?: string[] }

interface Props {
  module: string;
}

const { module: moduleName } = Astro.props;
const catalog = readJson<{ modules: CatalogModule[] }>(catalogPath);
const modules = catalog.modules;
const meta = modules.find((m) => m.name === moduleName);
if (!meta) throw new Error(`Unknown module ${moduleName}`);
const schema = readJson<any>(join(modulesDir, `${moduleName}.schema.json`));
const defs = schema.$defs || {};
const defEntries = (Object.entries(defs) as [string, any][]).map(([name, def]) => {
  const example = minimalExample(def);
  const exampleText = example === null ? '' : JSON.stringify(example, null, 2);
  return {
    name,
    def,
    node: describeNode(def),
    exampleHtml: exampleText ? jsonToSpecCodeHtml(exampleText) : ''
  };
});
const guide = MODULE_GUIDES[moduleName] || null;
const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={t('pages.reference.detailTitleSuffix', { title: meta.title })} description={meta.description}>
  <div class="container doc-layout">
    <DocAside current={moduleName} modules={modules} />
    <div>
      <header class="page-head" style="padding-top:0">
        <div class="eyebrow">{p('pages.reference.moduleEyebrow')}</div>
        <h1>{meta.title}</h1>
        {guide ? (
          <div class="module-guide">
            <p class="module-role">{guide.role}</p>
            <p>{guide.intro}</p>
            <p><strong>{p('pages.reference.useWhen')}</strong> {guide.useWhen}</p>
            <p><strong>{p('pages.reference.keepInMind')}</strong> {guide.caution}</p>
          </div>
        ) : (
          <p>{schema.description || meta.description}</p>
        )}
        <p class="schema-path">
          {p('pages.reference.rawSchema')}
          <a href={`/schema/1.0/modules/${moduleName}.schema.json`}>/schema/1.0/modules/{moduleName}.schema.json</a>
          {schema.$id && <> · <span class="mono">{schema.$id}</span></>}
        </p>
        <div class="callout">
          <strong>{p('pages.reference.readDefinitionTitle')}</strong>
          {p('pages.reference.readDefinitionBody')}
        </div>
        {defEntries.length > 0 && (
          <nav class="def-jump" aria-label={t('aria.definitionsOnPage')}>
            {defEntries.map((entry) => <a href={`#${entry.name}`}>{entry.name}</a>)}
          </nav>
        )}
      </header>
      {defEntries.map((entry) => (
        <section class="schema-section" id={entry.name}>
          <h2><code>{entry.name}</code></h2>
          {entry.def?.title && entry.def.title !== entry.name && <p class="constraints">{entry.def.title}</p>}
          <SchemaNode node={entry.node} />
          {entry.exampleHtml && (
            <div class="schema-example">
              <h3>{p('pages.reference.smallestExample')}</h3>
              <p>{p('pages.reference.smallestExampleLead')}</p>
              <SpecWindow caption={entry.name} badge="JSON" variant="doc">
                <pre class="spec-code" set:html={entry.exampleHtml}></pre>
              </SpecWindow>
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</Base>
