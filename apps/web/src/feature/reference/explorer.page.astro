---
import Base from '@app/layouts/Base.astro';
import ReferenceExplorer from './explorer';
---
<Base title="Reference explorer" description="Build Visual Spec visual-reference descriptors for websites, images, video, Figma, PDFs, and other evidence sources.">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">Locators</div>
      <h1>Reference explorer</h1>
      <p>Construct a visual-reference descriptor with kind, role, aspects and a kind-specific locator. No network calls are made.</p>
    </header>
    <ReferenceExplorer client:load />
  </div>
</Base>
