---
import Base from '@app/layouts/Base.astro';
import { t } from '@core/i18n';
import ReferenceExplorer from './explorer';

const p = (key: Parameters<typeof t>[0]) => t(key);
---
<Base title={p('pages.explorer.title')} description={p('pages.explorer.description')}>
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">{p('pages.explorer.eyebrow')}</div>
      <h1>{p('pages.explorer.heading')}</h1>
      <p>{p('pages.explorer.lead')}</p>
    </header>
    <ReferenceExplorer client:load />
  </div>
</Base>
