---
import { readdirSync, existsSync } from 'node:fs';
import Base from '@app/layouts/Base.astro';
import { DocAside, profilesSchemaDir } from '@core';
import { getMessages, t } from '@core/i18n';

const profileFiles = existsSync(profilesSchemaDir)
  ? readdirSync(profilesSchemaDir).filter((n) => n.endsWith('.schema.json')).sort()
  : [];
const artifacts = getMessages().pages.schemas.artifacts;
const p = (key: Parameters<typeof t>[0], params?: Parameters<typeof t>[1]) => t(key, params);
---
<Base title={p('pages.schemas.title')} description={p('pages.schemas.description')}>
  <div class="container doc-layout">
    <DocAside current="schemas" />
    <div>
    <header class="page-head">
      <div class="eyebrow">{p('pages.schemas.eyebrow')}</div>
      <h1>{p('pages.schemas.heading')}</h1>
      <p>{p('pages.schemas.lead')}</p>
    </header>

    <div class="callout">
      <strong>{p('pages.schemas.validateCallout')}</strong> {p('pages.schemas.validateCalloutBody')}
    </div>

    <section class="index-list" aria-labelledby="core-artifacts">
      <h2 id="core-artifacts" style="font-size:23px;margin:0 0 8px">{p('pages.schemas.coreArtifacts')}</h2>
      {artifacts.map(([title, href, desc]) => (
        <a class="index-row" href={href}>
          <div>
            <div class="row-title">{title}</div>
            <p>{desc}</p>
          </div>
          <span class="mono">{href}</span>
        </a>
      ))}
    </section>

    <section class="index-list" aria-labelledby="profile-artifacts">
      <h2 id="profile-artifacts" style="font-size:23px;margin:0 0 8px">{p('pages.schemas.profileArtifacts')}</h2>
      {profileFiles.map((file) => {
        const id = file.replace(/\.schema\.json$/, '');
        const href = `/schema/1.0/profiles/${file}`;
        return (
          <a class="index-row" href={href}>
            <div>
              <div class="row-title">{id}</div>
              <p>{p('pages.schemas.profileConstraints', { id })}</p>
            </div>
            <span class="mono">{href}</span>
          </a>
        );
      })}
    </section>
    </div>
  </div>
</Base>
